+
+/* Vault 2 brand system: graphite, champagne and the bundled Uncut Sans. */
+@layer base {
+  :root { color-scheme: dark; }
+  :focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
+}
+.vault2-navbar { min-height: 64px; background: #191b19; }
+.vault2-brand { display: inline-flex; align-items: center; gap: 12px; white-space: nowrap; font-size: 20px; font-weight: 650; letter-spacing: -.04em; line-height: 32px; }
+.vault2-mark { width: 32px; height: 32px; color: var(--color-primary); flex: none; }
+.vault2-number { color: var(--color-primary); }
+.vault2-home { display: inline-flex; border-radius: 6px; }
+.vault2-attribution { position: fixed; right: 24px; bottom: 16px; font-size: 11px; color: var(--color-text-muted); z-index: 5; }
+.vault2-attribution a { text-decoration: none; }
+.vault2-attribution a:hover { color: var(--color-primary); text-decoration: underline; }
+aside { background-color: #191b19; }
+aside a.font-semibold { color: var(--color-primary); background: rgba(216,197,140,.12); }
+aside a.font-semibold > span { color: inherit; }
+@media (max-width: 640px) {
+  .vault2-navbar { padding: 16px; gap: 12px; flex-wrap: wrap; }
+  .vault2-navbar > div:last-child { gap: 4px; margin-left: auto; }
+  .vault2-navbar button > span { max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: inline-block; }
+  .vault2-attribution { display: none; }
+  .vault2-brand { gap: 8px; font-size: 18px; }
+  .vault2-mark { width: 28px; height: 28px; }
+  form { min-width: 0; }
+}
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
+}
+
+/* Keep the same navigation available as a scrollable rail on smaller screens. */
+.vault2-app-shell { min-width: 0; max-width: 100%; }
+@media (max-width: 640px) {
+  .vault2-app-shell > div.flex.flex-1 { flex-direction: column; min-width: 0; }
+  .vault2-app-shell aside { width: 100%; max-width: 100%; border-right: 0; border-bottom: 1px solid var(--color-border); }
+  .vault2-app-shell aside > nav { flex-direction: row; align-items: center; gap: 8px; overflow-x: auto; padding: 12px; }
+  .vault2-app-shell aside nav ul { display: flex; flex: none; gap: 4px; }
+  .vault2-app-shell aside nav li { flex: none; margin: 0; }
+  .vault2-app-shell aside nav > div { flex: none; margin: 0; padding: 0; }
+  .vault2-app-shell aside nav > div > span { display: none; }
+  .vault2-app-shell aside nav a { white-space: nowrap; }
+  .vault2-app-shell main { min-width: 0; width: 100%; }
+  .vault2-app-shell main > div { min-width: 0; max-width: 100%; padding: 24px 16px; }
+  .vault2-app-shell main > div > div:first-child { flex-wrap: wrap; gap: 16px; }
+  .vault2-table { max-width: 100%; }
+  .vault2-table table { min-width: 560px; }
+}
